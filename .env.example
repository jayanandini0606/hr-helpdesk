# Environment variables for AI-Powered HR Helpdesk
# The application works 100% out of the box with zero external dependencies (deterministic rule-based AI fallback).
# Optional: To enable external LLM grounding, provide the following:

# Provider options: NONE (default fallback), OPENAI, ANTHROPIC, GEMINI
LLM_PROVIDER=NONE
LLM_API_KEY=
LLM_MODEL=

# App settings
FLASK_ENV=development
SECRET_KEY=yottaflex-fde-demo-secret-key-2026
DATABASE_PATH=data/hr_helpdesk.db
BUSINESS_CALENDAR=standard_business_hours
